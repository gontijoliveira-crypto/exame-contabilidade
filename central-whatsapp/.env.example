# Copie para .env e ajuste. Nunca suba o .env para o repositório.

# Porta do painel dos atendentes
PORTA=3000

# "baileys" conecta ao WhatsApp de verdade (lendo o QR code pelo celular).
# "simulador" não conecta a nada: as mensagens são digitadas no próprio painel, para testes.
WHATSAPP_MODO=simulador

# Chave da API da Anthropic (Claude) usada na triagem. Sem chave, tudo cai no setor padrão.
ANTHROPIC_API_KEY=
CLAUDE_MODELO=claude-opus-5-5

# Primeiro acesso ao painel (usado só quando ainda não existe nenhum atendente)
ADMIN_EMAIL=admin@escritorio.com.br
ADMIN_SENHA=

# Endereço pelo qual os atendentes abrem o painel (vai nos links de "esqueci minha senha")
URL_PAINEL=http://localhost:3000

# Servidor de e-mail para o "esqueci minha senha". Sem SMTP_HOST, o e-mail aparece no terminal.
# Exemplos: Google Workspace (smtp.gmail.com, porta 587, senha de app), Microsoft 365 (smtp.office365.com, 587).
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE="Central de Atendimento <nao-responda@escritorio.com.br>"

# Fonte dos indicadores e notícias da tela de entrada (padrão: o indicadores.json da Central de Painéis,
# em config/entrada.json). Aceita um endereço http(s) ou um caminho de arquivo.
# ENTRADA_FONTE=

# Segundos de espera para juntar mensagens seguidas do mesmo chat antes da triagem
ESPERA_TRIAGEM_SEGUNDOS=8

# Assina as respostas com o nome do atendente e do setor (true/false)
ASSINAR_RESPOSTAS=true

# Pasta dos dados (banco e sessão do WhatsApp)
PASTA_DADOS=./dados
